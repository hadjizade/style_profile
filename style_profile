    print('برچسب‌ها فرضیه‌اند. تفکیک آدم‌ها از هم با این فرمان انجام نمی‌شود و به متن مرجع نیاز دارد (verify).')
 
 
def cmd_fetch(a):
    try:
        import requests
        from bs4 import BeautifulSoup
    except ImportError:
        sys.exit('pip install requests beautifulsoup4')
    hdr = {'User-Agent': 'Mozilla/5.0 (compatible; stylometry-research)'}
    urls = []
 
    def walk(sm, depth=0):
        try:
            x = requests.get(sm, headers=hdr, timeout=30).text
        except Exception as e:
            print('sitemap error', sm, e); return
        for u in re.findall(r'<loc>\s*(?:<!\[CDATA\[)?\s*([^<\]]+?)\s*(?:\]\]>)?\s*</loc>', x):
            if re.search(r'\.xml(?:\.gz)?(?:\?|$)', u) or 'sitemap' in u.lower():
                if depth < 2:
                    walk(u, depth + 1)
            else:
                urls.append(u)
    for sm in a.sitemap:
        walk(sm)
    urls = sorted(set(urls))
    random.Random(a.seed).shuffle(urls)
    os.makedirs(a.out, exist_ok=True)
    meta = []; got = 0
    for u in urls:
        if got >= a.n:
            break
        try:
            r = requests.get(u, headers=hdr, timeout=30)
            r.encoding = r.apparent_encoding or 'utf-8'
            soup = BeautifulSoup(r.text, 'html.parser')
        except Exception:
            continue
        declared = ''
        m = soup.find('meta', attrs={'name': 'author'})
        if m and m.get('content'):
            declared = m['content'].strip()
        for tag in soup(['script', 'style', 'nav', 'header', 'footer', 'aside', 'form', 'noscript']):
            tag.decompose()
        root = soup.find(attrs={'itemprop': 'articleBody'}) or soup.find('article') or soup.body
        if not root:
            continue
        paras = [p.get_text('', strip=False).strip() for p in root.find_all(['p', 'li', 'h2', 'h3', 'blockquote'])]
        text = '\n'.join(p for p in paras if len(p) > 30)
        if len(words(text)) < a.min_words:
            continue
        got += 1
        fn = f'{got:03d}.txt'
        open(os.path.join(a.out, fn), 'w', encoding='utf-8').write(text + '\n')
        meta.append(dict(file=fn, url=u, words=len(words(text)), declared_byline=declared))
        print(got, len(words(text)), u)
    json.dump(meta, open(os.path.join(a.out, '_meta.json'), 'w', encoding='utf-8'), ensure_ascii=False, indent=1)
    print(f'{got} texts saved. declared_byline is metadata only, not evidence of authorship.')
 
 
