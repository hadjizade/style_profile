# ---------- General Impostors verification ----------
def deep_layer(t):
    """Remove the orthographic layer so only word choice and syntax remain."""
    t = t.replace(ZW, '').replace('ي', 'ی').replace('ك', 'ک').replace('ۀ', 'ه')
    t = re.sub(r'[ً-ْ]', '', t)
    t = re.sub(r'[0-9۰-۹٠-٩]+', '0', t)
    t = re.sub(r'[،؛:.!؟?«»"()\[\]…\-–—*]', ' ', t)
    return re.sub(r'\s+', ' ', t)
 
 
def char_ngrams(t, n=4):
    t = re.sub(r'\s+', ' ', t)
    c = collections.Counter(t[i:i + n] for i in range(len(t) - n + 1))
    tot = max(sum(c.values()), 1)
    return {g: v / tot for g, v in c.items()}
 
 
def impostor_score(u, known, imps, vocab, iters, rng):
    """Share of trials in which a known text beats every sampled impostor (min-max similarity on a random half of the features)."""
    if np is not None:
        U = np.array([u.get(g, 0.0) for g in vocab])
        K = np.array([[k.get(g, 0.0) for g in vocab] for k in known])
        I = np.array([[i.get(g, 0.0) for g in vocab] for i in imps])
        wins = 0; total = 0
        m = len(vocab)
        for _ in range(iters):
            idx = rng.sample(range(m), m // 2)
            pick = rng.sample(range(len(imps)), max(1, min(len(imps), len(imps) // 2 or 1)))
            u_ = U[idx]
            def sim(M):
                M_ = M[:, idx]
                return np.minimum(M_, u_).sum(1) / np.maximum(np.maximum(M_, u_).sum(1), 1e-12)
            best_imp = sim(I[pick]).max()
            sk = sim(K)
            wins += int((sk > best_imp).sum()); total += len(known)
        return wins / total
    wins = 0; total = 0
    for _ in range(max(10, iters // 5)):
        idx = rng.sample(vocab, len(vocab) // 2)
        pick = rng.sample(imps, max(1, len(imps) // 2))
        def sim(a):
            num = sum(min(a.get(g, 0), u.get(g, 0)) for g in idx); den = sum(max(a.get(g, 0), u.get(g, 0)) for g in idx)
            return num / den if den else 0
        best = max(sim(i) for i in pick)
        for k in known:
            wins += sim(k) > best; total += 1
    return wins / total
 
 
def cmd_verify(a):
    prep = deep_layer if a.layer == 'deep' else (lambda x: x)
    known = [(n, char_ngrams(prep(t))) for n, t in load_dir(a.known)]
    imps = [(n, char_ngrams(prep(t))) for n, t in load_dir(a.impostors)]
    unk = char_ngrams(prep(read(a.unknown)))
    if len(known) < 3 or len(imps) < 5:
        sys.exit('verify needs at least 3 known texts and 5 impostor texts')
    pool = collections.Counter()
    for _, d in known + imps:
        for g, v in d.items():
            pool[g] += v
    vocab = [g for g, _ in pool.most_common(a.features)]
    rng = random.Random(a.seed)
    K = [d for _, d in known]; I = [d for _, d in imps]
    score = impostor_score(unk, K, I, vocab, a.iters, rng)
    # calibration: each known text against the rest (true same-author), each impostor against the known set (true different)
    same = [impostor_score(K[i], K[:i] + K[i + 1:], I, vocab, a.iters, rng) for i in range(len(K))]
    diff = [impostor_score(I[i], K, I[:i] + I[i + 1:], vocab, a.iters, rng) for i in range(len(I))]
    lo_same, hi_diff = quant(same, .1), quant(diff, .9)
    print(f"# وارسی نویسندگی (General Impostors، لایه {a.layer})\n")
    print(f"متن‌های قطعی: {len(K)}، بدل‌ها: {len(I)}، ویژگی: {len(vocab)} چهارنگاشت حرفی، تکرار: {a.iters}\n")
    print(f"امتیاز متن ناشناس: {round(score, 3)}")
    print(f"کالیبراسیون، همان نویسنده (هر متن قطعی در برابر بقیه): میانه {round(quant(same, .5), 3)}، صدک ۱۰ {round(lo_same, 3)}")
    print(f"کالیبراسیون، نویسنده دیگر (هر بدل در برابر متن‌های قطعی): میانه {round(quant(diff, .5), 3)}، صدک ۹۰ {round(hi_diff, 3)}")
    if lo_same <= hi_diff:
        print('\nهشدار: دو توزیع کالیبراسیون روی هم افتاده‌اند؛ با این داده و این لایه، روش نویسنده را از بدل‌ها جدا نمی‌کند.')
        verdict = 'نامعلوم'
    elif score >= lo_same:
        verdict = 'سازگار با همان نویسنده'
    elif score <= hi_diff:
        verdict = 'ناسازگار با این نویسنده'
    else:
        side = 'نزدیک‌تر به همان نویسنده' if (score - hi_diff) > (lo_same - score) else 'نزدیک‌تر به نویسنده دیگر'
        verdict = f'نامعلوم (میان دو توزیع، {side})'
    print('\nحکم: ' + verdict)
    print('این حکم «قوت شاهد» است، نه اثبات. لایه raw رسم‌الخط را هم می‌بیند (ویراستار و مدل زبانی آن را عوض می‌کنند)؛ لایه deep فقط واژه و نحو را.')
 
 
def cmd_segment(a):
