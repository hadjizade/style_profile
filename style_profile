        if not cur:
            start = i
        cur.append(l); n += len(words(l))
        if n >= a.window:
            wins.append((start, i, '\n'.join(cur))); cur = []; n = 0
    if cur:
        wins.append((start, len(lines) - 1, '\n'.join(cur)))
    keys = ['semicolon', 'list_semicolon_end', 'heye', 'colloquial', 'formal', 'arabic_yk', 'tanvin_share', 'hamza_share', 'joste_zw_share', 'he_hamze', 'tashdid', 'first_sg', 'second_pers', 'sent_mean']
