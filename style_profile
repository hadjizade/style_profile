#!/usr/bin/env python3
"""stylo_lab.py v2: Persian stylometry lab.
 
What it is for
  1. profile  : measure the style of a site or of one author, as RANGES, and (with
                --background) say which features are actually distinctive.
  2. check    : is a new or edited text still inside the author's own range?
                The pass threshold is calibrated on the author's own texts (leave-one-out),
                so the gate is never stricter than the author is with themself.
  3. verify   : same-author test for an unknown text (General Impostors method,
                Koppel & Winter 2014), self-calibrated, with an explicit "unknown" zone.
  4. segment  : layer map of one long document (LLM-tidied / foreign orthography / rest).
  5. fetch    : pull raw article text from a sitemap (run on your own machine).
 
Design rules that came out of our experiments (2026-11-10)
  * Feed RAW text. Normalizing first (or letting a chat model retype the text) erases the
    orthographic layer, which was the strongest Persian signal we measured.
  * Style is a set of RATIOS inside a range, not a list of habits. An edit that pushes a
    habit above the author's own range is a caricature and is reported as such.
  * A feature is part of a signature only if it is STABLE inside the author and
    DISTINCTIVE against a background. Stable but not distinctive = language or house style.
  * An LLM-tidied text behaves like a different author. It is flagged, and should be
    removed from an author's reference corpus.
  * Declared bylines, schema and profiles are metadata, never evidence.
 
Usage
  python3 stylo_lab.py profile --dir texts/author_x --name "X" [--background texts/others] --json x.json --md x.md
  python3 stylo_lab.py check   --profile x.json --text edited.txt [--original before.txt]
  python3 stylo_lab.py verify  --known texts/author_x --unknown q.txt --impostors texts/others [--layer raw|deep]
  python3 stylo_lab.py segment --text long_doc.txt [--window 250]
  python3 stylo_lab.py fetch   --sitemap https://site/sitemap.xml --n 60 --out texts/site   (pip install requests beautifulsoup4)
 
One text per .txt/.md file. --background and --impostors may contain sub-folders.
Minimum data for numbers that mean something: 8 texts of 500+ words for a profile;
verify needs 3+ known texts and 5+ impostor texts of the same genre.
Needs only the standard library; numpy is used when present (faster verify).
"""
import argparse, collections, glob, json, os, random, re, statistics as st, sys
 
try:
    import numpy as np
except ImportError:  # pragma: no cover
    np = None
 
ZW = '‌'
WORD = re.compile(r'[\w‌]+')
SENT_SPLIT = re.compile(r'(?<=[.!؟?])\s+|\n+')
 
BARE_TANVIN = (r'\b(?:اصلا|معمولا|حتما|کاملا|دقیقا|تقریبا|واقعا|لطفا|مثلا|قطعا|عملا|نسبتا|اتفاقا|ضمنا|اخیرا|فعلا|احتمالا|صرفا|'
               r'لزوما|قبلا|بعدا|ظاهرا|اساسا|مستقیما|نهایتا|ترجیحا|عمدا|غالبا|عمدتا|شدیدا|طبیعتا)\b')
MI_JOINED = (r'(?<![\w‌])ن?می(?:خوا|تو[ا]?ن|دان|دون|شو|شه|ش[ن]|کن|گوی|گ[ه]|رو|ر[ه]|بین|ده|گیر|رس|ساز|آی|یاب|نویس|خوان|'
             r'کش|ذار|گذار|بر|پرس|افت|ماند|آور|دید|خور|زن|فهم)\w*')
COLLOQUIAL = (r'\b(?:ن?می[‌ ]?(?:خوام|خوای|خواد|خوایم|خواین|تونم|تونی|تونه|تونیم|تونید|تونن|دونم|دونی|دونه|شه|کنه|کنن|'
              r'گه|گن|گم|ره|رن|ذارم|ذاره|بینی|بینه)|یه|اون|اونا|اونها|اینا|رو|هستش|داره|دارن|باشه|بشه|نمیشه|میشه|بذار|بگیم|'
              r'بریم|یکم|دیگه|خب|واسه|اگه|چیه|کیه|همینه)\b')
FORMAL = r'\b(?:بلکه|زیرا|نیز|در واقع|همانند|چنین|به شمار|می‌باشد|می‌باشند|گردید|گردد|لذا|می‌توان)\b'
HAMZA_ON = r'سؤال|تأثیر|تأمین|تأکید|تأیید|مسئول|مؤثر|مؤسسه|رأی|مسئله'
HAMZA_OFF = r'سوال|تاثیر|تامین|تاکید|تایید|مسوول|موثر|موسسه|مساله'
RELATIONS = {
    'علت': ['چون', 'زیرا', 'چرا که', 'از آنجا که', 'به این دلیل که', 'برای اینکه', 'به خاطر اینکه'],
    'تقابل': ['اما', 'ولی', 'با این حال', 'در مقابل', 'بااین‌حال', 'هرچند'],
    'شرط': ['اگر', 'در صورتی که', 'چنانچه', 'به شرطی که'],
    'نتیجه': ['پس', 'بنابراین', 'در نتیجه', 'به همین دلیل', 'برای همین', 'لذا'],
    'افزودن': ['همچنین', 'علاوه بر این', 'علاوه‌براین', 'به‌علاوه', 'نیز'],
    'مثال': ['مثلا', 'مثلاً', 'برای مثال', 'به عنوان مثال', 'به‌عنوان مثال'],
}
 
# name, family, Persian description. Rates are per 1000 words; *_share are 0..1; sent_* are words.
FEATURES = [
    ('mi_halfspace_share', 'رسم‌الخط', 'سهم «می» با نیم‌فاصله از همه «می»های فعلی'),
    ('ha_halfspace_share', 'رسم‌الخط', 'سهم «ها»ی نیم‌فاصله از «ها»ی جدا و نیم‌فاصله'),
    ('tanvin_share', 'رسم‌الخط', 'سهم قید با تنوین (مثلاً) از کل این قیدها'),
    ('hamza_share', 'رسم‌الخط', 'سهم املای همزه‌دار (سؤال، تأثیر) از دو املا'),
    ('joste_zw_share', 'رسم‌الخط', 'سهم «جست‌وجو» از «جستجو» و «جست‌وجو»'),
    ('latin_digit_share', 'رسم‌الخط', 'سهم ارقام لاتین از همه ارقام'),
    ('arabic_yk', 'رسم‌الخط', 'ی و ک عربی'),
    ('heye', 'رسم‌الخط', '«ه‌ی» اضافه (زمینه‌ی)'),
    ('he_hamze', 'رسم‌الخط', '«ۀ»'),
    ('tashdid', 'رسم‌الخط', 'تشدید'),
    ('space_before_punct', 'رسم‌الخط', 'فاصله پیش از نشانه'),
    ('colloquial', 'لحن', 'فعل و ضمیر محاوره‌ای'),
    ('ra', 'لحن', '«را»'),
    ('ast', 'لحن', '«است»'),
    ('formal', 'لحن', 'ربط و فعل رسمی (بلکه، زیرا، نیز، می‌باشد، می‌توان)'),
    ('first_sg', 'لحن', 'اول‌شخص مفرد'),
    ('first_pl', 'لحن', 'اول‌شخص جمع'),
    ('second_pers', 'لحن', 'خطاب به خواننده'),
    ('semicolon', 'نشانه‌گذاری', '؛'),
    ('colon', 'نشانه‌گذاری', ':'),
    ('comma', 'نشانه‌گذاری', '،'),
    ('paren', 'نشانه‌گذاری', 'پرانتز'),
    ('guillemet', 'نشانه‌گذاری', '«'),
    ('exclam', 'نشانه‌گذاری', '!'),
    ('question', 'نشانه‌گذاری', '؟'),
    ('ellipsis', 'نشانه‌گذاری', 'سه‌نقطه'),
    ('emoticon', 'نشانه‌گذاری', 'شکلک'),
    ('list_semicolon_end', 'ساختار', 'سطر فهرست که با ؛ تمام می‌شود'),
    ('para_mean', 'ساختار', 'میانگین طول پاراگراف (واژه)'),
    ('sent_mean', 'جمله', 'میانگین طول جمله (واژه)'),
    ('sent_sd', 'جمله', 'انحراف معیار طول جمله'),
    ('sent_long_share', 'جمله', 'سهم جمله‌های بالای ۳۰ واژه'),
    ('sent_short_share', 'جمله', 'سهم جمله‌های زیر ۸ واژه'),
    ('latin_words', 'واژه', 'واژه با خط لاتین'),
    ('ttr_200', 'واژه', 'تنوع واژگان (TTR پنجره ۲۰۰ واژه‌ای)'),
]
NAMES = [f[0] for f in FEATURES]
DESC = {f[0]: (f[1], f[2]) for f in FEATURES}
 
 
def read(path):
    return open(path, encoding='utf-8', errors='replace').read().lstrip('﻿')
 
 
def words(t):
    return WORD.findall(t)
 
 
def sentences(t):
    return [s for s in SENT_SPLIT.split(t) if len(words(s)) >= 3]
 
 
def share(a, b):
    return a / (a + b) if (a + b) >= 3 else None  # fewer than 3 instances: not measurable
 
 
def features(t):
    w = words(t)
    n = max(len(w), 1)
    k = 1000 / n
    f = {'_words': len(w)}
    mi_zw = len(re.findall(r'(?<![\w‌])ن?می‌\w', t))
    mi_other = len(re.findall(r'(?<![\w‌])ن?می \w{2,}', t)) + len(re.findall(MI_JOINED, t))
    f['mi_halfspace_share'] = share(mi_zw, mi_other)
    f['ha_halfspace_share'] = share(len(re.findall(r'\w‌ها', t)), len(re.findall(r'\w ها\b', t)))
    f['tanvin_share'] = share(len(re.findall(r'\w+(?:اً|ًا)', t)), len(re.findall(BARE_TANVIN, t)))
    f['hamza_share'] = share(len(re.findall(HAMZA_ON, t)), len(re.findall(HAMZA_OFF, t)))
    f['joste_zw_share'] = share(len(re.findall(r'جست‌و‌?جو', t)), len(re.findall(r'جستجو', t)))
    f['latin_digit_share'] = share(len(re.findall(r'[0-9]', t)), len(re.findall(r'[۰-۹٠-٩]', t)))
    f['arabic_yk'] = (t.count('ي') + t.count('ك')) * k
    f['heye'] = len(re.findall(r'ه‌ی\b', t)) * k
    f['he_hamze'] = t.count('ۀ') * k
    f['tashdid'] = t.count('ّ') * k
    f['space_before_punct'] = len(re.findall(r' [،.؛:؟!]', t)) * k
    f['colloquial'] = len(re.findall(COLLOQUIAL, t)) * k
    f['ra'] = len(re.findall(r'\bرا\b', t)) * k
    f['ast'] = len(re.findall(r'\bاست\b', t)) * k
    f['formal'] = len(re.findall(FORMAL, t)) * k
    f['first_sg'] = len(re.findall(r'\b(?:من|کردم|دارم|هستم|بودم|نوشتم|دیدم|می‌کنم|می‌گویم|می‌گم|نظرم)\b', t)) * k
    f['first_pl'] = len(re.findall(r'\b(?:ما|کنیم|داریم|می‌کنیم|هستیم|بودیم|می‌خواهیم)\b', t)) * k
    f['second_pers'] = len(re.findall(r'\b(?:شما|کنید|دارید|باشید|بنویسید|تو|کنی|داری|باشی)\b', t)) * k
    f['semicolon'] = t.count('؛') * k
    f['colon'] = t.count(':') * k
    f['comma'] = t.count('،') * k
    f['paren'] = t.count('(') * k
    f['guillemet'] = t.count('«') * k
    f['exclam'] = t.count('!') * k
    f['question'] = (t.count('؟') + t.count('?')) * k
    f['ellipsis'] = (t.count('...') + t.count('…')) * k
    f['emoticon'] = (len(re.findall(r'[\U0001F300-\U0001FAFF☀-➿]', t)) + t.count(':)')) * k
    f['list_semicolon_end'] = len(re.findall(r'؛\s*$', t, flags=re.M)) * k
    paras = [len(words(p)) for p in t.split('\n') if len(words(p)) >= 15]
    f['para_mean'] = st.mean(paras) if paras else None
    sl = [len(words(s)) for s in sentences(t)]
    if sl:
        f['sent_mean'] = st.mean(sl)
        f['sent_sd'] = st.pstdev(sl)
        f['sent_long_share'] = sum(1 for x in sl if x > 30) / len(sl)
        f['sent_short_share'] = sum(1 for x in sl if x < 8) / len(sl)
    else:
        f['sent_mean'] = f['sent_sd'] = f['sent_long_share'] = f['sent_short_share'] = None
    f['latin_words'] = len(re.findall(r'[A-Za-z]{2,}', t)) * k
    wl = [x.replace(ZW, '') for x in w]
    tt = [len(set(wl[i:i + 200])) / 200 for i in range(0, len(wl) - 199, 200)]
    f['ttr_200'] = st.mean(tt) if tt else None
    return f
 
 
def looks_llm(f):
    """LLM-tidied heuristic (from round 1 and round 2). A hypothesis, not a verdict."""
    s = 0
    s += (f.get('mi_halfspace_share') or 0) >= 0.98
    s += f.get('colloquial', 0) < 1
    s += f.get('semicolon', 0) >= 15 or f.get('list_semicolon_end', 0) >= 5
    s += f.get('formal', 0) >= 6
    s += f.get('joste_zw_share') == 1 or f.get('hamza_share') == 1
    s += f.get('heye', 0) == 0 and f.get('_words', 0) >= 300
    return s >= 4
 
 
def connectors(t):
    out = {}
    for rel, items in RELATIONS.items():
        c = {i: len(re.findall(r'(?<![\w‌])' + re.escape(i) + r'(?![\w‌])', t)) for i in items}
        out[rel] = {a: b for a, b in c.items() if b}
    return out
 
 
def openers(texts, top=15):
    c = collections.Counter()
    for t in texts:
        for s in sentences(t):
            w = words(s)
            if w:
                c[w[0]] += 1
    return c.most_common(top)
 
 
def load_dir(d):
    paths = sorted(glob.glob(os.path.join(d, '**', '*.txt'), recursive=True) + glob.glob(os.path.join(d, '**', '*.md'), recursive=True))
    return [(os.path.relpath(p, d), read(p)) for p in paths if not os.path.basename(p).startswith('_')]
 
 
def quant(vals, p):
    vals = sorted(vals)
    if not vals:
        return None
    i = p * (len(vals) - 1)
    lo, hi = int(i), min(int(i) + 1, len(vals) - 1)
    return vals[lo] + (vals[hi] - vals[lo]) * (i - lo)
 
 
def band(vals, is_share=False):
    """Tolerance band of one feature: the middle half widened by one IQR on each side.
    With zero IQR the band is the observed min..max. Rates cannot go below 0, shares stay in 0..1."""
    p25, p75 = quant(vals, .25), quant(vals, .75)
    iqr = p75 - p25
    lo, hi = p25 - iqr, p75 + iqr
    if iqr == 0:
        lo, hi = min(vals), max(vals)
    lo = max(lo, 0.0)
    if is_share:
        hi = min(hi, 1.0)
    return lo, hi
 
 
def summarize(feats):
    out = {}
    for name in NAMES:
        vals = [f[name] for f in feats if f.get(name) is not None]
        if len(vals) < 3:
            out[name] = None
            continue
        is_share = name.endswith('_share')
        lo, hi = band(vals, is_share)
        mean = st.mean(vals)
        cv = st.pstdev(vals) / mean if mean else 0
        iqr = quant(vals, .75) - quant(vals, .25)
        present = sum(1 for v in vals if v > 0) / len(vals)
        tight = (iqr <= 0.15) if is_share else (cv <= 0.4)
        if present <= 0.1:
            status = 'قاعده: تقریباً هرگز'
        elif present >= 0.8 and tight:
            status = 'قاعده پایدار'
        elif present >= 0.5:
            status = 'گرایش'
        else:
            status = 'متغیر'
        out[name] = dict(median=round(quant(vals, .5), 3), p25=round(quant(vals, .25), 3), p75=round(quant(vals, .75), 3),
                         lo=round(lo, 3), hi=round(hi, 3), cv=round(cv, 2), present=round(present, 2), status=status, n=len(vals))
    return out
 
 
def out_of_band(f, summ):
    """Features outside the author's band: (name, value, direction, exceedance).
    Exceedance = distance outside the band in band-widths, capped at 3, so one wild feature cannot dominate."""
    res = []
    for name in NAMES:
        s, v = summ.get(name), f.get(name)
        if not s or v is None:
            continue
        width = s['hi'] - s['lo']
        if width <= 0:
            width = 0.1 if name.endswith('_share') else max(1.0, 0.25 * abs(s['hi']))
        tol = 0.02 * width
        if v > s['hi'] + tol:
            res.append((name, v, 'above', min(3.0, (v - s['hi']) / width)))
        elif v < s['lo'] - tol:
            res.append((name, v, 'below', min(3.0, (s['lo'] - v) / width)))
    return res
 
 
def drift(miss):
    return sum(m[3] for m in miss)
 
 
# ---------- Burrows Delta ----------
def mfw_list(texts, n=100):
    c = collections.Counter(x.replace(ZW, '') for t in texts for x in words(t))
    return [w for w, _ in c.most_common(n)]
 
 
def relfreq(t, mfw):
    w = [x.replace(ZW, '') for x in words(t)]
    c = collections.Counter(w)
    n = max(len(w), 1)
    return [c[x] / n for x in mfw]
 
 
def delta(a, b, sd):
    return st.mean(abs(x - y) / s for x, y, s in zip(a, b, sd))
 
 
def build_profile(texts, name, background=None):
    feats = [features(t) for _, t in texts]
    summ = summarize(feats)
    warnings = []
    nw = sum(f['_words'] for f in feats)
    if len(texts) < 8:
        warnings.append(f'فقط {len(texts)} متن: بازه‌ها توصیفی‌اند، نه معیار پذیرش (حداقل ۸ متن).')
    if nw < 5000:
        warnings.append(f'{nw} واژه: Delta ناپایدار است؛ به رسم‌الخط و لحن تکیه کنید.')
    short = [tn for (tn, _), f in zip(texts, feats) if f['_words'] < 400]
    if short:
        warnings.append(f'{len(short)} متن کوتاه‌تر از ۴۰۰ واژه (نرخ‌هایشان پرنوسان است): ' + '، '.join(short[:6]))
    llm = [tn for (tn, _), f in zip(texts, feats) if looks_llm(f)]
    if llm:
        warnings.append('نشانه لایه مدل زبانی؛ پیش از ساخت پروفایل نویسنده این متن‌ها را بازبینی یا حذف کنید: ' + '، '.join(llm[:8]))
    # leave-one-out self calibration: how many features does the author's OWN text miss?
    self_miss, self_drift = [], []
    if len(texts) >= 5:
        for i, f in enumerate(feats):
            m = out_of_band(f, summarize([x for j, x in enumerate(feats) if j != i]))
            self_miss.append(len(m)); self_drift.append(drift(m))
    calib = None
    if self_miss:
        q1, q3 = quant(self_drift, .25), quant(self_drift, .75)
        fence = q3 + 1.5 * (q3 - q1)
        far = [f'{tn} ({d:.1f})' for (tn, _), d in zip(texts, self_drift) if d > fence and d > 1]
        if far:
            warnings.append(f'متن‌های دور از بقیه متن‌های همین پیکره (رانش بالاتر از حصار توکی {fence:.1f}): ' + '، '.join(far[:8]))
        calib = dict(miss_median=quant(self_miss, .5), miss_p90=quant(self_miss, .9),
                     drift_median=round(quant(self_drift, .5), 2), drift_p90=round(quant(self_drift, .9), 2),
                     drift_values=[round(x, 2) for x in self_drift])
    # Delta space: z-scale on background + own texts when a background exists
    pool = [t for _, t in texts] + ([t for _, t in background] if background else [])
    mfw = mfw_list(pool, 100)
    vecs = [relfreq(t, mfw) for t in pool]
    sd = [st.pstdev(c) or 1e-9 for c in zip(*vecs)]
    own = vecs[:len(texts)]
    centroid = [st.mean(c) for c in zip(*own)]
    intra = None
    if len(own) >= 5:
        ds = []
        for i, v in enumerate(own):
            c = [st.mean(col) for col in zip(*[x for j, x in enumerate(own) if j != i])]
            ds.append(delta(v, c, sd))
        intra = dict(median=round(quant(ds, .5), 3), p90=round(quant(ds, .9), 3))
    distinct = None
    if background:
        bf = [features(t) for _, t in background]
        bs = summarize(bf)
        distinct = []
        for fn in NAMES:
            a, b = summ.get(fn), bs.get(fn)
            if not a or not b:
                continue
            spread = max(b['p75'] - b['p25'], a['p75'] - a['p25'], 0.05 * max(abs(b['median']), abs(a['median']), 1e-9), 1e-9)
            eff = (a['median'] - b['median']) / spread
            stable = a['status'].startswith('قاعده')
            level = 'نه'
            if abs(eff) >= 1:
                level = 'قوی' if stable else 'ضعیف (ناپایدار در خود نویسنده)'
            distinct.append(dict(feature=fn, author=a['median'], background=b['median'], effect=round(eff, 2), stable=stable, signature=level))
        distinct.sort(key=lambda d: -abs(d['effect']))
        if intra:
            bvecs = vecs[len(texts):]
            bd = [delta(v, centroid, sd) for v in bvecs]
            intra['background_median'] = round(quant(bd, .5), 3)
            intra['background_p10'] = round(quant(bd, .1), 3)
    allt = '\n'.join(t for _, t in texts)
    return dict(name=name, n_texts=len(texts), n_words=nw, features=summ, calibration=calib, intra_delta=intra,
                distinctive=distinct, connectors=connectors(allt), openers=openers([t for _, t in texts]),
                mfw=mfw, mfw_sd=sd, centroid=centroid, warnings=warnings,
                per_text={tn: {k: (round(v, 3) if isinstance(v, float) else v) for k, v in f.items()} for (tn, _), f in zip(texts, feats)})
 
 
def profile_md(p):
